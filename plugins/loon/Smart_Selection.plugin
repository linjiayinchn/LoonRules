#!name = Smart Selection
#!desc = 多策略组智能选路（V1.0.0-rc.3）；按质量独立选路，管理组留空即全选。
#!system = iOS,iPadOS
#!loon_version = 3.5.1(983)

[Argument]
dailyMB = select,200,100,50,300,type=number,tag=每日下载预算（MB）,desc=所有策略组共享的预扣预算
groups = input,"",type=string,tag=管理策略组,desc=留空检测并管理全部纯节点组；指定组名用英文分号分隔；接管组须为 select
autoSelect = switch,true,type=boolean,tag=自动选路,desc=开启后按管理范围自动选路；关闭只检测
notify = switch,false,type=boolean,tag=切换通知,desc=仅确认切换时通知
autoProbe = switch,true,type=boolean,tag=定时检测,desc=每30分钟分批检测并按设置选路

[Script]
generic then script("https://raw.githubusercontent.com/GFStillpoint/RoutingRules/main/plugins/loon/smart-selection/Smart_Selection.js?v=1.0.0-rc.3", {${dailyMB}, ${groups}, ${autoSelect}, ${notify}}) with tag="Smart Selection · 一键诊断", timeout=220, img_url="gauge.system"
cron "*/30 * * * *" then script("https://raw.githubusercontent.com/GFStillpoint/RoutingRules/main/plugins/loon/smart-selection/Smart_Selection.js?v=1.0.0-rc.3", {${dailyMB}, ${groups}, ${autoSelect}, ${notify}}) with enable=${autoProbe}, tag="Smart Selection · 定时检测", timeout=220
network-changed then script("https://raw.githubusercontent.com/GFStillpoint/RoutingRules/main/plugins/loon/smart-selection/Smart_Selection.js?v=1.0.0-rc.3", {${dailyMB}, ${groups}, ${autoSelect}, ${notify}}) with enable=${autoProbe}, tag="Smart Selection · 网络变化", timeout=220
